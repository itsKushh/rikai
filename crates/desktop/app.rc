1 ICON "../../assets/rikai.ico"
#define STRINGIFY_(x) #x
#define STRINGIFY(x) STRINGIFY_(x)
#define VERSION_TEXT STRINGIFY(RIKAI_MAJOR) "." STRINGIFY(RIKAI_MINOR) "." STRINGIFY(RIKAI_PATCH)
1 VERSIONINFO
FILEVERSION RIKAI_MAJOR,RIKAI_MINOR,RIKAI_PATCH,0
PRODUCTVERSION RIKAI_MAJOR,RIKAI_MINOR,RIKAI_PATCH,0
FILEOS 0x40004
FILETYPE 1
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Rikai\0"
            VALUE "FileVersion", VERSION_TEXT "\0"
            VALUE "ProductName", "Rikai\0"
            VALUE "ProductVersion", VERSION_TEXT "\0"
            VALUE "OriginalFilename", "rikai.exe\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
