<Window x:Class="Rikai.Setup.SetupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:Rikai.Setup"
 Title="{DynamicResource Title}" Width="392" SizeToContent="Height" WindowStartupLocation="CenterScreen"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanMinimize"
 FontFamily="./Fonts/#Inter, Segoe UI" FontSize="13" Foreground="#EDEDF0"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
 <Window.Resources>
  <LinearGradientBrush x:Key="Rim" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#21FFFFFF"/><GradientStop Color="#0BFFFFFF" Offset=".12"/>
   <GradientStop Color="#0BFFFFFF" Offset=".86"/><GradientStop Color="#44000000" Offset="1"/>
  </LinearGradientBrush>
  <LinearGradientBrush x:Key="InsetShadow" StartPoint="0,0" EndPoint="0,1">
   <GradientStop Color="#57000000"/><GradientStop Color="#14000000" Offset=".06"/><GradientStop Color="#00000000" Offset=".12"/>
  </LinearGradientBrush>
  <Style TargetType="{x:Type local:SetupButton}">
   <Setter Property="Padding" Value="13,5"/><Setter Property="MinHeight" Value="32"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="Foreground" Value="#EDEDF0"/>
   <Setter Property="FontWeight" Value="Medium"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
   <Setter Property="Template"><Setter.Value>
    <ControlTemplate TargetType="{x:Type local:SetupButton}">
     <Grid Background="Transparent">
      <Grid x:Name="Face">
       <Border x:Name="BaseFill" CornerRadius="{TemplateBinding Radius}" Background="#2C2C30"><Border.Effect>
        <DropShadowEffect Color="Black" BlurRadius="2" ShadowDepth="1" Direction="270" Opacity=".27"/>
       </Border.Effect></Border>
       <Border x:Name="HoverFill" CornerRadius="{TemplateBinding Radius}" Background="#36363A" Opacity="0"/>
       <Border x:Name="Rim" CornerRadius="{TemplateBinding Radius}" BorderBrush="{StaticResource Rim}" BorderThickness="1"/>
       <Border x:Name="Inset" CornerRadius="{TemplateBinding Radius}" Background="{StaticResource InsetShadow}" Opacity="0"/>
       <ContentPresenter Margin="{TemplateBinding Padding}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
       <Border x:Name="FocusRing" CornerRadius="{TemplateBinding Radius}" BorderThickness="1" BorderBrush="#CCCCD4" IsHitTestVisible="False" Opacity="0"/>
      </Grid>
     </Grid>
     <ControlTemplate.Triggers>
      <Trigger Property="Tone" Value="Primary"><Setter TargetName="BaseFill" Property="Background" Value="#E5E5E9"/><Setter TargetName="HoverFill" Property="Background" Value="#CACACE"/><Setter Property="Foreground" Value="#1C1C20"/></Trigger>
      <Trigger Property="Tone" Value="Quiet"><Setter TargetName="BaseFill" Property="Background" Value="Transparent"/><Setter TargetName="HoverFill" Property="Background" Value="#2C2C30"/><Setter TargetName="Rim" Property="Visibility" Value="Hidden"/><Setter Property="Foreground" Value="#A5A5AD"/></Trigger>
      <Trigger Property="Tone" Value="Caption"><Setter TargetName="BaseFill" Property="Background" Value="Transparent"/><Setter TargetName="Rim" Property="Visibility" Value="Hidden"/></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter Property="Cursor" Value="No"/></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate>
   </Setter.Value></Setter>
  </Style>
  <Style TargetType="ToolTip">
   <Setter Property="Foreground" Value="#EDEDF0"/><Setter Property="FontFamily" Value="./Fonts/#Inter, Segoe UI"/><Setter Property="FontSize" Value="11"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToolTip">
    <Border Background="#29292D" BorderBrush="#49494F" BorderThickness="1" CornerRadius="8" Padding="9,5"><ContentPresenter/></Border>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,7"/></Style>
  <Style x:Key="Hint" TargetType="TextBlock"><Setter Property="Foreground" Value="#A5A5AD"/><Setter Property="FontSize" Value="11.5"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="ComboBoxItem">
   <Setter Property="MinHeight" Value="27"/><Setter Property="Foreground" Value="#EDEDF0"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
    <Border x:Name="Item" CornerRadius="10" Padding="9,4" Background="Transparent">
     <DockPanel><Rectangle x:Name="Tick" DockPanel.Dock="Right" Width="14" Height="14" Fill="#EDEDF0" OpacityMask="{StaticResource Glyph.check}" Visibility="Hidden"/><ContentPresenter/></DockPanel>
    </Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="#333337"/></Trigger>
     <Trigger Property="IsSelected" Value="True"><Setter TargetName="Item" Property="Background" Value="#36363B"/><Setter TargetName="Tick" Property="Visibility" Value="Visible"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <ControlTemplate x:Key="LanguageField" TargetType="ComboBox">
   <Grid>
    <Border x:Name="FieldFace" CornerRadius="12" Background="#2C2C30" BorderBrush="{StaticResource Rim}" BorderThickness="1"/>
    <DockPanel Margin="11,0" IsHitTestVisible="False">
     <Rectangle DockPanel.Dock="Left" Width="16" Height="16" Margin="0,0,9,0" Fill="#A5A5AD" OpacityMask="{StaticResource Glyph.language}"/>
     <Rectangle x:Name="Chevron" DockPanel.Dock="Right" Width="12" Height="12" Fill="#A5A5AD" OpacityMask="{StaticResource Glyph.chevron-down}" RenderTransformOrigin=".5,.5"/>
     <ContentPresenter VerticalAlignment="Center" Content="{TemplateBinding SelectionBoxItem}"/>
    </DockPanel>
    <ToggleButton Focusable="False" Cursor="Hand" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"/></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" VerticalOffset="4" PopupAnimation="Fade" Focusable="False">
     <Border Width="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Background="#28282B" CornerRadius="14" Padding="4">
      <ScrollViewer MaxHeight="190" VerticalScrollBarVisibility="Auto"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
     </Border>
    </Popup>
   </Grid>
   <ControlTemplate.Triggers>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FieldFace" Property="Background" Value="#353539"/></Trigger>
    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FieldFace" Property="BorderBrush" Value="#93939C"/></Trigger>
    <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="Chevron" Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></Trigger>
   </ControlTemplate.Triggers>
  </ControlTemplate>
 </Window.Resources>
 <Grid>
  <Border CornerRadius="16">
   <Border.Background><LinearGradientBrush StartPoint=".15,0" EndPoint=".85,1"><GradientStop Color="#242427"/><GradientStop Color="#1D1D20" Offset=".78"/></LinearGradientBrush></Border.Background>
   <Grid>
    <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="Auto" MinHeight="204"/><RowDefinition Height="Auto" MinHeight="58"/></Grid.RowDefinitions>
    <Border Background="Transparent" BorderBrush="#0BFFFFFF" BorderThickness="0,0,0,1" Padding="16,6,8,6" MouseLeftButtonDown="DragTitle">
     <DockPanel>
      <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
       <local:SetupButton Tone="Caption" Padding="0" Radius="8" Width="32" ToolTip="{DynamicResource Minimize}" AutomationProperties.Name="{DynamicResource Minimize}" Click="MinimizeWindow"><Rectangle Width="14" Height="14" Fill="#EDEDF0" OpacityMask="{StaticResource Glyph.minus}"/></local:SetupButton>
       <local:SetupButton Tone="Caption" Padding="0" Radius="8" Width="32" ToolTip="{DynamicResource Close}" AutomationProperties.Name="{DynamicResource Close}" Click="CloseWindow"><Rectangle Width="14" Height="14" Fill="#EDEDF0" OpacityMask="{StaticResource Glyph.xmark}"/></local:SetupButton>
      </StackPanel>
      <Image DockPanel.Dock="Left" Width="24" Height="24" Margin="0,0,10,0" Source="Images/rikai-mini-icon.png" RenderOptions.BitmapScalingMode="HighQuality"/>
      <TextBlock Text="{DynamicResource Title}" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     </DockPanel>
    </Border>
    <StackPanel x:Name="WelcomePanel" Grid.Row="1" Margin="20">
     <TextBlock Text="{DynamicResource Language}" Style="{StaticResource FieldLabel}"/>
     <ComboBox x:Name="LocalePicker" Height="36" Foreground="#EDEDF0" Template="{StaticResource LanguageField}" AutomationProperties.Name="{DynamicResource Language}" SelectionChanged="SelectLanguage">
      <ComboBoxItem Tag="fr" Content="Français"/><ComboBoxItem Tag="en" Content="English"/><ComboBoxItem Tag="es" Content="Español"/>
      <ComboBoxItem Tag="ru" Content="Русский"/><ComboBoxItem Tag="ja" Content="日本語"/><ComboBoxItem Tag="zh" Content="简体中文"/>
     </ComboBox>
     <TextBlock Text="{DynamicResource Folder}" Style="{StaticResource FieldLabel}" Margin="0,17,0,7"/>
     <Border Background="#141416" BorderThickness="1" CornerRadius="12" Padding="3" MinHeight="36">
      <Border.Style><Style TargetType="Border"><Setter Property="BorderBrush" Value="#18181B"/><Style.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter Property="BorderBrush" Value="#93939C"/></Trigger></Style.Triggers></Style></Border.Style>
      <DockPanel>
       <local:SetupButton Tone="Quiet" DockPanel.Dock="Right" Width="30" Height="28" MinHeight="28" Radius="8" Padding="0" Click="BrowseFolder" ToolTip="{DynamicResource Browse}" AutomationProperties.Name="{DynamicResource Browse}"><Rectangle Width="16" Height="16" Fill="#A5A5AD" OpacityMask="{StaticResource Glyph.folder-open}"/></local:SetupButton>
       <TextBox x:Name="Destination" AutomationProperties.AutomationId="Destination" AutomationProperties.Name="{DynamicResource Folder}" Background="Transparent" Foreground="#EDEDF0" BorderThickness="0" FontSize="12" CaretBrush="White" Padding="7,0,5,0" VerticalContentAlignment="Center" TextChanged="ClearPathError"/>
      </DockPanel>
     </Border>
     <TextBlock Text="{DynamicResource UserOnly}" Style="{StaticResource Hint}" Margin="0,7,0,0"/>
     <TextBlock x:Name="PathHint" Text="{DynamicResource Invalid}" Style="{StaticResource Hint}" Foreground="#F1B4B4" Margin="0,5,0,0" Visibility="Collapsed"/>
    </StackPanel>
    <StackPanel x:Name="GuidedPanel" Grid.Row="1" Margin="20" Visibility="Collapsed">
     <DockPanel><TextBlock x:Name="Percent" DockPanel.Dock="Right" VerticalAlignment="Center" FontSize="12" Foreground="#C5C5CC" Margin="8,0,0,0"/>
      <TextBlock x:Name="Heading" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap"/>
     </DockPanel>
     <Border x:Name="Track" Height="5" CornerRadius="3" Background="#36363A" Margin="0,12,0,13"><Border x:Name="Fill" HorizontalAlignment="Left" Width="0" CornerRadius="3">
      <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,0"><GradientStop Color="#BCBCC5"/><GradientStop Color="#EDEDF0" Offset="1"/></LinearGradientBrush></Border.Background>
     </Border></Border>
     <StackPanel x:Name="Steps"/>
     <TextBlock x:Name="Status" Margin="0,7,0,0"><TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource Hint}"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
    </StackPanel>
    <Border Grid.Row="2" Background="#19191C" CornerRadius="0,0,16,16" BorderBrush="#0DFFFFFF" BorderThickness="0,1,0,0" Padding="16,12">
     <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition/></Grid.ColumnDefinitions>
      <TextBlock x:Name="VersionLabel" Foreground="#A5A5AD" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
      <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
       <local:SetupButton x:Name="InstallButton" Tone="Primary" AutomationProperties.AutomationId="Install" IsDefault="True" Content="{DynamicResource Install}" Click="StartInstall"/>
       <local:SetupButton x:Name="LogButton" Tone="Quiet" Margin="0,0,8,0" Content="{DynamicResource Log}" Visibility="Collapsed" Click="OpenLog"/>
       <local:SetupButton x:Name="CloseButton" Tone="Quiet" Margin="0,0,8,0" AutomationProperties.AutomationId="FinishClose" Content="{DynamicResource Close}" Visibility="Collapsed" Click="CloseWindow"/>
       <local:SetupButton x:Name="MainButton" AutomationProperties.AutomationId="MainAction" Visibility="Collapsed" Click="GuidedAction"/>
      </WrapPanel>
     </Grid>
    </Border>
   </Grid>
  </Border>
  <Border CornerRadius="16" BorderThickness="1" IsHitTestVisible="False">
   <Border.BorderBrush><LinearGradientBrush StartPoint="0,0" EndPoint="0,1"><GradientStop Color="#49494E"/><GradientStop Color="#39393D" Offset=".22"/><GradientStop Color="#303034" Offset="1"/></LinearGradientBrush></Border.BorderBrush>
  </Border>
 </Grid>
</Window>
