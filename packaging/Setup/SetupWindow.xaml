<Window x:Class="Rikai.Setup.SetupWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Title}" Width="596" SizeToContent="Height" WindowStartupLocation="CenterScreen"
 WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanMinimize"
 FontFamily="./Fonts/#Inter, Segoe UI" FontSize="13" Foreground="#EDEDF0"
 UseLayoutRounding="True" TextOptions.TextFormattingMode="Display">
  <Window.Resources>
    <Style TargetType="Button">
      <Setter Property="Padding" Value="14,7"/><Setter Property="MinHeight" Value="32"/>
      <Setter Property="Cursor" Value="Hand"/><Setter Property="Background" Value="#303034"/>
      <Setter Property="BorderBrush" Value="#4B4B50"/><Setter Property="Foreground" Value="#EDEDF0"/>
      <Setter Property="FontWeight" Value="SemiBold"/>
      <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
        <Border x:Name="Edge" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1"
            Padding="{TemplateBinding Padding}">
          <Grid><Border x:Name="Light" Margin="-2,-1" CornerRadius="8" Background="White" Opacity="0"/>
            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
        </Border>
        <ControlTemplate.Triggers>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Edge" Property="BorderBrush" Value="#CCCCD4"/></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Light" Storyboard.TargetProperty="Opacity" To=".075" Duration="0:0:0.12"/>
          </Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard>
            <DoubleAnimation Storyboard.TargetName="Light" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.14"/>
          </Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
          <Trigger Property="IsPressed" Value="True"><Setter TargetName="Edge" Property="RenderTransform"><Setter.Value><TranslateTransform Y="0.6"/></Setter.Value></Setter></Trigger>
          <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Edge" Property="Opacity" Value=".5"/></Trigger>
        </ControlTemplate.Triggers>
      </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="Quiet" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Padding" Value="7"/><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Setter Property="Foreground" Value="#ACACB5"/>
    </Style>
    <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
      <Setter Property="Background" Value="#E5E5E9"/><Setter Property="Foreground" Value="#1C1C20"/><Setter Property="BorderBrush" Value="#F4F4F6"/>
    </Style>
    <Style x:Key="Muted" TargetType="TextBlock"><Setter Property="Foreground" Value="#ADADB6"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  </Window.Resources>
  <Border CornerRadius="16" BorderThickness="1" BorderBrush="#48484E">
    <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint="1,1"><GradientStop Color="#27272B"/><GradientStop Color="#1D1D20" Offset="1"/></LinearGradientBrush></Border.Background>
    <Grid><Grid.RowDefinitions><RowDefinition Height="46"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
      <Grid Background="Transparent" MouseLeftButtonDown="DragTitle" Margin="18,0,10,0">
        <TextBlock Text="{DynamicResource Title}" FontSize="12" Foreground="#D1D1D7" VerticalAlignment="Center"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
          <Button Style="{StaticResource Quiet}" AutomationProperties.Name="{DynamicResource Minimize}" ToolTip="{DynamicResource Minimize}" Width="32" Click="MinimizeWindow"><Path StrokeThickness="1.4" Stroke="#A5A5AD" Data="M0,5 L10,5"/></Button>
          <Button Style="{StaticResource Quiet}" AutomationProperties.Name="{DynamicResource Close}" ToolTip="{DynamicResource Close}" Width="32" Click="CloseWindow"><Path StrokeThickness="1.4" Stroke="#A5A5AD" Data="M1,1 L10,10 M10,1 L1,10"/></Button>
        </StackPanel>
      </Grid>
      <StackPanel x:Name="WelcomePanel" Grid.Row="1">
        <StackPanel Margin="38,12,38,30">
          <Grid Margin="0,0,0,28"><Grid.ColumnDefinitions><ColumnDefinition Width="80"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <Image Source="Images/rikai.png" Stretch="Uniform" Width="80" Height="80"/>
            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="21,0,0,0">
              <TextBlock Text="{DynamicResource Welcome}" FontWeight="SemiBold" FontSize="36" TextWrapping="Wrap"/>
              <TextBlock Text="{DynamicResource Intro}" Style="{StaticResource Muted}" Margin="0,4,0,0"/>
            </StackPanel>
          </Grid>
          <TextBlock Text="{DynamicResource Folder}" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,7"/>
          <Border x:Name="PathBorder" Background="#141416" BorderThickness="1" BorderBrush="#18181B" CornerRadius="10" Padding="4,2">
            <DockPanel><Button DockPanel.Dock="Right" Style="{StaticResource Quiet}" Click="BrowseFolder" AutomationProperties.Name="{DynamicResource Browse}" ToolTip="{DynamicResource Browse}">
                <Path Stroke="#CDCDD5" StrokeThickness="1.4" Data="M1,4 L6,4 8,6 16,6 16,8 M1,4 L1,15 14,15 17,8 4,8 1,15"/>
              </Button>
              <TextBox x:Name="Destination" AutomationProperties.AutomationId="Destination" AutomationProperties.Name="{DynamicResource Folder}" Background="Transparent" Foreground="#EDEDF0" BorderThickness="0" CaretBrush="White" Padding="8,4" VerticalContentAlignment="Center"/>
            </DockPanel>
          </Border>
          <TextBlock x:Name="PathHint" Text="{DynamicResource UserOnly}" Style="{StaticResource Muted}" FontSize="12" Margin="0,9,0,0"/>
        </StackPanel>
        <Border Background="#19191B" CornerRadius="0,0,15,15" Padding="26,13" BorderBrush="#323236" BorderThickness="0,1,0,0"><Grid>
          <TextBlock x:Name="VersionLabel" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Center"/>
          <Button x:Name="InstallButton" AutomationProperties.AutomationId="Install" IsDefault="True" Style="{StaticResource Primary}" HorizontalAlignment="Right" Click="StartInstall">
            <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource Install}"/><Path Margin="8,0,0,0" VerticalAlignment="Center" Stroke="#252529" StrokeThickness="1.5" Data="M1,6 L13,6 M8,1 L13,6 8,11"/></StackPanel>
          </Button>
        </Grid></Border>
      </StackPanel>
      <Border x:Name="GuidedPanel" Grid.Row="1" BorderBrush="#353539" BorderThickness="0,1,0,0" Visibility="Collapsed"><Grid MinHeight="347">
        <Grid.ColumnDefinitions><ColumnDefinition Width="0.36*"/><ColumnDefinition Width="0.64*"/></Grid.ColumnDefinitions>
        <Border Background="#151517" CornerRadius="0,0,0,15"><Grid ClipToBounds="True">
          <StackPanel Orientation="Horizontal" Margin="25,28" VerticalAlignment="Top"><Image Width="28" Height="28" Source="Images/wave.png"/><TextBlock Text="Rikai" Margin="9,0,0,0" FontSize="31" FontWeight="SemiBold"/></StackPanel>
          <Viewbox Stretch="Fill" Height="100"><Canvas x:Name="Wave" Width="330" Height="100"/></Viewbox>
          <TextBlock x:Name="GuidedVersion" Margin="25,16" FontSize="12" Style="{StaticResource Muted}" VerticalAlignment="Bottom"/>
        </Grid></Border>
        <Grid Grid.Column="1" Margin="31,28,31,22">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <DockPanel><TextBlock x:Name="Percent" DockPanel.Dock="Right" FontSize="18" Margin="10,4,0,0" Text="0 %"/>
            <TextBlock x:Name="Heading" Text="{DynamicResource Installing}" FontSize="25" FontWeight="SemiBold" TextWrapping="Wrap"/></DockPanel>
          <TextBlock x:Name="Status" Grid.Row="1" Text="{DynamicResource LocalFiles}" Style="{StaticResource Muted}" Margin="0,6,0,0"/>
          <Border x:Name="Track" Grid.Row="2" Height="5" CornerRadius="3" Background="#37373B" Margin="0,17"><Border x:Name="Fill" HorizontalAlignment="Left" Width="0" CornerRadius="3" Background="#E6E6EB"/></Border>
          <StackPanel x:Name="Steps" Grid.Row="3"/>
          <WrapPanel Grid.Row="5" HorizontalAlignment="Right" Margin="0,19,0,0">
            <Button x:Name="LogButton" Content="{DynamicResource Log}" Margin="0,0,7,0" Visibility="Collapsed" Click="OpenLog"/>
            <Button x:Name="CloseButton" AutomationProperties.AutomationId="FinishClose" Content="{DynamicResource Close}" Margin="0,0,7,0" Visibility="Collapsed" Click="CloseWindow"/>
            <Button x:Name="MainButton" AutomationProperties.AutomationId="MainAction" Content="{DynamicResource Cancel}" Click="GuidedAction"/>
          </WrapPanel>
        </Grid>
      </Grid></Border>
    </Grid>
  </Border>
</Window>
