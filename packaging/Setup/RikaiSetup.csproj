<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <ProjectTypeGuids>{60DC8134-EBA5-43B8-BCC9-BB4BC16C2548};{FAE04EC0-301F-11D3-BF4B-00C04F79EFBC}</ProjectTypeGuids>
    <OutputType>WinExe</OutputType>
    <AssemblyName>RikaiSetup</AssemblyName>
    <RootNamespace>Rikai.Setup</RootNamespace>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget>
    <OutputPath>..\..\dist\setup-build\</OutputPath>
    <IntermediateOutputPath>..\..\dist\setup-obj\</IntermediateOutputPath>
    <Optimize>true</Optimize>
    <IncludePackageReferencesDuringMarkupCompilation>false</IncludePackageReferencesDuringMarkupCompilation>
    <ApplicationIcon>..\..\assets\rikai.ico</ApplicationIcon>
    <ApplicationManifest>setup.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Xaml"/><Reference Include="System.Xml"/>
    <Reference Include="System.Drawing"/><Reference Include="System.Windows.Forms"/><Reference Include="WindowsBase"/>
    <Reference Include="PresentationFramework"/><Reference Include="PresentationCore"/>
    <Page Include="SetupWindow.xaml"/>
    <Compile Include="Program.cs"/><Compile Include="SetupTheme.cs"/><Compile Include="SetupWindow.xaml.cs"/>
    <Compile Include="..\..\dist\setup-version.cs"/>
    <Resource Include="..\..\assets\inter\Inter.ttf"><Link>Fonts\Inter.ttf</Link></Resource>
    <Resource Include="..\..\assets\rikai-mini-icon.png"><Link>Images\rikai-mini-icon.png</Link></Resource>
    <EmbeddedResource Include="..\..\assets\nucleo\minus.svg;..\..\assets\nucleo\xmark.svg;..\..\assets\nucleo\language.svg;..\..\assets\nucleo\chevron-down.svg;..\..\assets\nucleo\folder-open.svg;..\..\assets\nucleo\check.svg">
      <LogicalName>Rikai.Icon.%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\..\dist\installer-engine\Rikai-Payload.exe"><LogicalName>Rikai.Payload</LogicalName></EmbeddedResource>
    <EmbeddedResource Include="strings.tsv"><LogicalName>Rikai.Strings</LogicalName></EmbeddedResource>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
